# FindBack 2.0 - Environment Configuration Template
# Copy this file to '.env' and populate with your local secrets.
# In accordance with security standards, '.env' is git-ignored and must never be committed.

# Application Secret Key (required)
# Generate a cryptographically secure 32-byte hex string with:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-secure-random-32-byte-hex-string

# Flask Environment ('development' or 'production')
FLASK_ENV=development

# Database Connection (PostgreSQL for cloud production, or SQLite for local dev)
# For local SQLite development (default if omitted):
# DATABASE=findback.db
# For production managed PostgreSQL (e.g. Neon or Supabase):
# DATABASE_URL=postgresql://username:password@ep-example-host.neon.tech/neondb?sslmode=require

# Initial Staff Account Credentials
# These passwords are required ONLY when initializing a new database (via python database/init_db.py).
# They are immediately hashed using Werkzeug scrypt/pbkdf2 and stored securely.
INITIAL_ADMIN_PASSWORD=replace-with-secure-initial-admin-password
INITIAL_DESK_STAFF_PASSWORD=replace-with-secure-initial-desk-staff-password
